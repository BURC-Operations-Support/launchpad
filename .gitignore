
# ============================================================
# BURC Launchpad — Git exclusions
# ============================================================

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Python virtual environments and packaging
.venv/
venv/
env/
*.egg-info/
dist/

# ROS 2 / colcon generated artifacts
build/
install/
log/

# CMake artifacts
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
cmake-build-*/

# Compiled binaries and libraries
*.o
*.obj
*.a
*.lib
*.dll
*.dylib
*.exe

# Environment variables and credentials
.env
.env.*
!.env.example
!.env.*.example
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# Editor metadata
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*~

# Operating system artifacts
.DS_Store
.AppleDouble
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
tmp/
temp/
*.tmp

# Local caches
.cache/
